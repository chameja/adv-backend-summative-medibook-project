# Copy to .env and fill in your own values. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=medibook_user
DB_PASSWORD=change_me
DB_NAME=medibook
DB_POOL_SIZE=10

# Optional: where the audit log is written (default: logs/audit.log)
# AUDIT_LOG_FILE=logs/audit.log

# Redis (waitlist + background jobs)
REDIS_URL=redis://localhost:6379
